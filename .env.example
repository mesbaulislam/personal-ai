# Copy this file to ".env" and fill in your own values.
# Never commit a real ".env" file — it holds secrets.

# OpenRouter API key for AI replies
OPENROUTER_API_KEY=your-openrouter-api-key

# Login password for user Mesbaul_AI
PERSONAL_AI_PASSWORD=your-login-password

# Long random secret used to sign session cookies (required at startup)
SESSION_SECRET=your-long-random-session-secret

# Cloudflare D1 access (all three required for chat storage)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
D1_DATABASE_ID=your-d1-database-id
